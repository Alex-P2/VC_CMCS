@{
    ViewData["Title"] = "Invoices";
}

@{
    await Html.RenderPartialAsync("_LoginPartial");
}

@model InvoicesViewModel

<div class="container justify-content-center">
    <div class="d-flex flex-column position-relative px-3" style="top:160px;max-height: 680px; min-height: 600px; border: 1px solid var(--bg-accent); border-radius: 4px; box-shadow: var(--bg-accent); background-color: var(--bg-secondary);">
        <div class="d-flex flex-row justify-content-between py-2" style="background-color: var(--bg-secondary);">
            <h3 class="text-light">Invoices</h3>
        </div>

        <div class="d-flex flex-row mt-2 overflow-auto pb-2 gap-3">
            <div class="table-responsive w-100">
                <table class="table table-bordered rounded-2">
                    <thead class="sticky-top" style="background-color: var(--bg-secondary); color:white;">
                        <tr>
                            <th>Invoice #</th>
                            <th>Lecturer</th>
                            <th>Lecturer Email</th>
                            <th>Date Created</th>
                            <th>Payment Due</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody style="background-color:white; color: black;">
                        @if (Model.Invoices != null && Model.Invoices.Count > 0)
                        {
                            foreach (var invoice in Model.Invoices)
                            {
                                <tr data-claim-id="@invoice.Invoice.InvoiceID">
                                    <td>@invoice.Invoice.InvoiceID</td>
                                    <td>@invoice.LecturerName</td>
                                    <td>@invoice.LecturerEmail</td>
                                    <td>@invoice.Invoice.DateCreated</td>
                                    <td>@invoice.Invoice.PaymentDue</td>
                                    <td>
                                        <div class="d-flex flex-nowrap gap-3">
                                            <a asp-action="DownloadInvoice" asp-route-InvoiceID="@invoice.Invoice.InvoiceID" asp-route-TableAction="view" target="_blank" class="btn-theme btn-theme-primary details-btn" style="color:white;background-color:var(--bg-secondary)">View</a>
                                            <a asp-action="DownloadInvoice" asp-route-InvoiceID="@invoice.Invoice.InvoiceID" asp-route-TableAction="download" class="btn-theme btn-theme-primary details-btn" style="color:white;background-color:var(--bg-secondary)">Download</a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td>No invoices found.</td>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@if (TempData["ToastData"] is not null)
{
    <partial name="_ToastPartial" model="@(TempData["ToastData"])" />
}
