@{
    ViewData["Title"] = "Reports";
}

@{
    await Html.RenderPartialAsync("_LoginPartial");
}

<div class="container justify-content-center">
    <div class="row position-relative p-3" style="top:160px;max-height: 680px; min-height: 600px; border: 1px solid var(--bg-accent); border-radius: 4px; box-shadow: var(--bg-accent); background-color: var(--bg-secondary);">
        <div class="col gap-3 py-2" style="background-color: var(--bg-secondary);">
            <div class="row">
                <h3 class="text-light text-decoration-underline">Generate Statistics Report</h3>
                <h5 class="text-light">Performance & Cost Metrics</h5>
            </div>
            <div class="row py-2">
                <div class="col">
                    <div class="d-flex gap-2 position-relative">
                        <a asp-action="GenerateStatisticsReport" target="_blank" class="btn-theme btn-theme-accent text-center align-content-center py-2 px-3">All Time</a>
                        <a asp-action="GenerateStatisticsReport" asp-route-timeframe="3" target="_blank" class="btn-theme btn-theme-accent text-center align-content-center py-2 px-3">3 Months</a>
                        <a asp-action="GenerateStatisticsReport" asp-route-timeframe="6" target="_blank" class="btn-theme btn-theme-accent text-center align-content-center py-2 px-3">6 Months</a>
                        <a asp-action="GenerateStatisticsReport" asp-route-timeframe="12" target="_blank" class="btn-theme btn-theme-accent text-center align-content-center py-2 px-3">12 Months</a>
                    </div>
                </div>

                <div class="col">
                </div>
            </div>
        </div>
    </div>
</div>

@if (TempData["ToastData"] is not null)
{
    <partial name="_ToastPartial" model="@(TempData["ToastData"])" />
}