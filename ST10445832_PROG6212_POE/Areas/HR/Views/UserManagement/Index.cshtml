@{
    ViewData["Title"] = "User Management";
}

@model UserManagementViewModel

@{
    await Html.RenderPartialAsync("_LoginPartial");
}

<div class="container justify-content-center">
    <div class="d-flex flex-column position-relative px-3" style="top:160px;max-height: 680px; min-height: 600px; border: 1px solid var(--bg-accent); border-radius: 4px; box-shadow: var(--bg-accent); background-color: var(--bg-secondary);">
        <div class="d-flex flex-row justify-content-between py-2" style="background-color: var(--bg-secondary);">
            <h3 class="text-light">User Management</h3>
            <form asp-action="Index" class="align-content-center">
                <div class="input-group">
                    <input class="form-control" type="text" name="query" placeholder="" value="@Model.Query" />
                    <button class="btn" style="background-color:var(--bg-accent)"><i class="bi bi-search"></i></button>
                    @if (Model.Filtered)
                    {
                        <a asp-action="Index" class="btn ms-1" style="background-color:var(--bg-accent)"><i class="bi bi-x-square"></i></a>
                    }
                </div>
            </form>
        </div>

        <div class="d-flex flex-row mt-2 overflow-auto pb-2 gap-3">
            <div style="width:240px;">
                <div class="d-flex flex-column">
                    <a asp-action="Index" asp-route-query="" class="claim-filter-option py-2 px-3 shadow-sm @(Model.Filter.Equals(string.Empty) ? "active-filter" : "")">All Users</a>
                    <a asp-action="Index" asp-route-query="Academic Manager" class="claim-filter-option py-2 px-3 shadow-sm @(Model.Filter.Equals("Verified") ? "active-filter" : "")">Academic Managers</a>
                    <a asp-action="Index" asp-route-query="Lecturer" class="claim-filter-option py-2 px-3 shadow-sm @(Model.Filter.Equals("Approved") ? "active-filter" : "")">Lecturers</a>
                    <a asp-action="Index" asp-route-query="Programme Coordinator" class="claim-filter-option py-2 px-3 shadow-sm @(Model.Filter.Equals("Approved") ? "active-filter" : "")">Programme Coordinators</a>
                </div>
                <button onclick="location.href = '@Url.ActionLink("Create", "UserManagement")'" class="btn-theme btn-theme-accent py-2 mt-2">New User <i class="bi bi-plus"></i></button>
            </div>
            <div class="table-responsive w-100">
                <table class="table table-bordered rounded-2">
                    <thead class="sticky-top" style="background-color: var(--bg-secondary); color:white;">
                        <tr>
                            <th>Username</th>
                            <th>Role</th>
                            <th>Email</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody style="background-color:white; color: black;">
                        @if (Model.Users.Count > 0)
                        {
                            foreach (var user in Model.Users)
                            {
                                <tr data-user-id="@user.Id">
                                    <td>@user.UserName</td>
                                    <td>@user.Role</td>
                                    <td>@user.Email</td>
                                    <td>
                                        <div class="d-flex flex-nowrap gap-3">
                                            <a href="@Url.ActionLink("Update", "UserManagement", new { userId = user.Id })" class="btn-theme btn-theme-primary details-btn align-content-center" style="color:white;background-color:var(--bg-secondary)">Update</a>
                                            <button class="btn-theme btn-modal-reject table-action-btn py-2" data-bs-toggle="modal" data-bs-target="#confirmDelete" data-user-id="@user.Id">Delete</button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td>No users found.</td>
                                <td></td>
                                <td></td>
                                <td></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>
</div>

<div class="modal" id="confirmDelete">
    <div class="modal-dialog rounded-3">
        <div class="modal-content rounded-3" style="border: 1px solid var(--bg-accent);background-color:var(--bg-secondary);">
            <div class="modal-header rounded-3" style="border-bottom: 1px solid var(--bg-accent);background-color:var(--bg-secondary);">
                <h5 class="modal-title">Delete User: <span id="delete-user-id"></span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" style="color:white;">
                <p>Are you sure you want to delete this user?</p>
            </div>
            <div class="modal-footer py-4 rounded-3" style="border-top: 1px solid var(--bg-accent);background-color:var(--bg-secondary);">
                <div class="d-flex w-100 gap-3 justify-content-center align-items-center">
                    <a id="delete-confirm-btn" class="btn-theme btn-modal-reject py-2 text-center">Delete</a>
                </div>
            </div>
        </div>
    </div>
</div>


@if (TempData["ToastData"] is not null)
{
    <partial name="_ToastPartial" model="@(TempData["ToastData"])" />
}

<script type="text/javascript">
    document.addEventListener("DOMContentLoaded", () => {
        var filters = document.querySelectorAll('.role-filter-option');
        for (let i=0; i < filters.length; i++) {
            filters[i].addEventListener('click', () => {
                if (!filters[i].classList.contains('active-filter'))
                {
                    var prev = document.querySelector('.role-filter-option.active-filter');
                    prev.classList.remove('active-filter');
                    filters[i].classList.add('active-filter')
                }
            });
        }
    });
</script>

<script type="text/javascript">
    $('.btn-modal-reject.table-action-btn').click((event) => {
        const targetuserID = event.target.getAttribute('data-user-id');
        const userIdSpan = document.querySelector('#delete-user-id');
        userIdSpan.innerText = targetuserID;
        const withdrawBtn = document.querySelector('#delete-confirm-btn');
        withdrawBtn.href = `/HR/UserManagement/Delete?userID=${targetuserID}`;
    });
</script>