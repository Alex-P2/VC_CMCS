@*
    References

*@

@{
    ViewData["Title"] = "Home";
}

@{
    await Html.RenderPartialAsync("_LoginPartial");
}

<div class="d-flex position-relative justify-content-center" style="width:100%;top:160px;">
    <div class="d-flex justify-content-center gap-5" style="width:600px;">
        <a asp-controller="Claim" asp-action="Create" class="btn-theme btn-theme-secondary">
            <div class="d-flex flex-column justify-content-center pb-3">
                <i class="bi bi-pencil-square" style="color:white;text-align:center;vertical-align:bottom;font-size:128px;"></i>
                <span style="color:white;text-align:center;font-size:24px;">Make Claim</span>
            </div>
        </a>
        <a asp-controller="Claim" asp-action="Index" class="btn-theme btn-theme-secondary">
            <div class="d-flex flex-column justify-content-center pb-3">
                <span style="color:white;text-align:center;font-size:128px;">
                    <i class="bi bi-clock"></i>
                </span>
                <span style="color:white;text-align:center;font-size:24px;">Claim History</span>
            </div>
        </a>
    </div>
</div>

@if (TempData["ToastData"] is not null)
{
    <partial name="_ToastPartial" model="@(TempData["ToastData"])" />
}