@{
    ViewData["Title"] = "My Account";
}

@{
    await Html.RenderPartialAsync("_LoginPartial");
}

<div class="d-flex flex-column gap-1 position-relative justify-content-center align-items-center" style="width:100%;top:150px;">
    <form class="form-theme" asp-action="UpdateAccount">
        <div class="form-theme-header">
            <h2>My Account</h2>
        </div>

        <div class="form-theme-inner d-flex flex-row justify-content-center gap-4" style="padding: 4rem 4rem;">
            <div class="d-flex flex-column gap-3 w-100">
                <p style="color:var(--bg-accent);">Personal Information</p>
                <input class="input-theme py-3 px-2" type="text" placeholder="First Name" />
                <input class="input-theme py-3 px-2" type="text" placeholder="Last Name" />
                <input class="input-theme py-3 px-2" type="text" placeholder="Email Address" />
            </div>
            <div class="d-flex flex-column gap-3 w-100">
                <p style="color:var(--bg-accent);">Bank Account Details</p>
                <input class="input-theme py-3 px-2" type="text" placeholder="Account Holder" />
                <input class="input-theme py-3 px-2" type="text" placeholder="Bank Name" />
                <input class="input-theme py-3 px-2" type="text" placeholder="Branch Number" />
                <input class="input-theme py-3 px-2" type="text" placeholder="Account Number" />
            </div>
        </div>

        <div class="form-theme-footer" style="">
            <input class="btn-theme btn-theme-accent py-3" type="submit" value="Update" />
        </div>
    </form>
</div>
